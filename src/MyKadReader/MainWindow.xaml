<Window x:Class="MyKadReader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MyKadReader"
 Title="MyKad Reader" Width="1040" Height="820" MinWidth="820" MinHeight="650" Background="#F3F6FA" Foreground="#182A43" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
   <TextBlock Text="MyKad Reader" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="Portable • Offline • Save only when you choose" Foreground="#65758B" Margin="0,5,0,0"/>
   <TextBlock x:Name="ModeLabel" Text="Prototype — card compatibility requires hardware verification." FontSize="12" Foreground="#8B5A16" Margin="0,8,0,0"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="12" Background="#E7EDF5" CornerRadius="6">
   <StackPanel><TextBlock x:Name="StorageStatus" FontSize="12"/><TextBlock Text="Saved records are stored locally without encryption. Close the app before copying or backing up its Data folder." Foreground="#65758B" FontSize="12" Margin="0,5,0,0"/></StackPanel>
  </Border>
  <TabControl Background="Transparent" BorderThickness="0">
   <TabItem Header="Reader">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,18,0,0">
      <TextBlock Text="SMART-CARD READER" FontSize="11" Foreground="#65758B" Margin="0,0,0,6"/>
      <ComboBox x:Name="Readers" MinHeight="36" SelectionChanged="ReaderChanged"/>
      <TextBlock x:Name="ReaderStatus" Text="Checking readers…" Margin="0,10,0,16"/>
      <WrapPanel Margin="0,0,0,18">
       <Button x:Name="ReadButton" Content="Read card" Click="ReadClick" IsEnabled="False" Background="#164FAD" Foreground="White"/>
       <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" IsEnabled="False"/>
       <Button x:Name="ClearButton" Content="Clear" Click="ClearClick"/>
       <Button x:Name="SaveButton" Content="Save to database" Click="SaveClick" IsEnabled="False"/>
      </WrapPanel>
      <local:IdentityView x:Name="CurrentView"/>
      <TextBlock x:Name="ReadResult" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Saved records">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,18,0,0">
      <DockPanel Margin="0,0,0,12">
       <Button DockPanel.Dock="Right" Content="Search" Click="SearchClick" Margin="8,0,0,0"/>
       <TextBox x:Name="SearchText" MinHeight="36" VerticalContentAlignment="Center" Padding="8" ToolTip="Search by name or MyKad number" AutomationProperties.Name="Search by name or MyKad number" KeyDown="SearchKeyDown"/>
      </DockPanel>
      <DataGrid x:Name="Records" Height="170" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="RecordSelected" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="MyKad number" Binding="{Binding Number}" Width="160"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Last saved (UTC)" Binding="{Binding UpdatedUtc}" Width="260"/>
       </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,12,0,12">
       <Button x:Name="PreviousButton" Content="Previous" Click="PreviousClick" IsEnabled="False"/>
       <Button x:Name="NextButton" Content="Next" Click="NextClick" IsEnabled="False"/>
       <Button x:Name="DeleteButton" Content="Delete selected" Click="DeleteClick" IsEnabled="False"/>
       <TextBlock x:Name="PageLabel" VerticalAlignment="Center"/>
      </WrapPanel>
      <TextBlock x:Name="RecordsStatus" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
      <local:IdentityView x:Name="SavedView"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
